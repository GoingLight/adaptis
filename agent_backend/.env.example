DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://agent:agent@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Colleague's RAG service
RAG_SERVICE_URL=http://localhost:8001
RAG_SERVICE_TOKEN=shared-secret
# Secret the RAG service sends back on /internal/rag-callback/
RAG_CALLBACK_SECRET=another-shared-secret

# Where uploaded files are served from (RAG side may need to fetch them)
PUBLIC_BASE_URL=http://localhost:8000

# Must match the Verify Token you enter in the Meta app's webhook settings
META_VERIFY_TOKEN=adaptis-verify
